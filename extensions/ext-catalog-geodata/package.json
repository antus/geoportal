{
  "name": "ext-catalog-geodata",
  "version": "2.0.0-SNAPSHOT",
  "private": true,
  "description": "The geodata of the catalog: loading into PostGIS and COG, GeoServer and GeoFence, publishing, data rules, the data gateway and the proxy of OGC services.",
  "author": "Massimo Antonini",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "mvn -q package -DskipTests && node ../../tools/mosaikit-ext.mjs --bench -- .",
    "pretest": "playwright install chromium",
    "test": "playwright test"
  },
  "devDependencies": {
    "@mosaikit/testing": "https://github.com/mosaikit/mosaikit/releases/download/snapshot/mosaikit-testing-latest.tgz",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64": true,
    "@embedded-postgres/linux-x64": true,
    "@embedded-postgres/linux-arm64": true,
    "@embedded-postgres/darwin-x64": true,
    "@embedded-postgres/darwin-arm64": true
  }
}
