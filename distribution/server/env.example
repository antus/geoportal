# SPDX-FileCopyrightText: 2026 Massimo Antonini
#
# Settings of the stack. The build writes a copy as .env the first time and never overwrites it:
# change every password in .env before the first start.
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me-too
GEOSERVER_DB_PASSWORD=change-me-as-well
KEYCLOAK_ADMIN_PASSWORD=change-me-now
GEOSERVER_ADMIN_PASSWORD=change-me-soon
GEOPORTAL_ADMIN_PASSWORD=change-me-today
# The login with which GeoServer reads the roles of people from the published views of Geoportal; letters
# and digits are enough.
GEOSERVER_READER_PASSWORD=change-me-also
# The master key of the credentials of organizations and of the links to files: 32 random bytes in
# base64, made with `openssl rand -base64 32`. Replace this one; changing it later makes the stored
# credentials unreadable.
GEOPORTAL_MASTER_KEY=Z2VvcG9ydGFsLXJlcGxhY2UtdGhpcy1tYXN0ZXJrZXk=
# Secret of the Keycloak client with which Geoportal creates the realms of organizations.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-this-secret
# Public URL of Keycloak, as browsers reach it.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# Signed extension packages: "required" (default: the extensions of Geoportal are signed by its
# build) or "optional", to try extensions of others.
MOSAIKIT_EXTENSIONS_SIGNATURES=required
# The key of the service identity "gateway" of Geoportal (mks_...), with which the gateway checks the
# personal keys of QGIS (see README.md, "QGIS"): empty until a platform administrator creates it.
GATEWAY_SERVICE_KEY=
# The largest upload, such as 512M or 2G: the gateway and the kernel both take it (see README.md).
GEOPORTAL_MAX_UPLOAD=1G
# Ports on this computer: Geoportal with its data gateway, Keycloak, and the administration of GeoServer
# (127.0.0.1 only).
GEOPORTAL_PORT=8080
KEYCLOAK_PORT=8180
GEOSERVER_PORT=8280
# The private network of the gateway and GeoServer (<prefix>.0/24, the gateway at .10): change it only if
# it collides with another network of this computer.
GEOSERVER_NETWORK=10.231.0
# Mail (see README.md, "Mail"): the server that sends the links with which people who register confirm
# their address. Without one, nobody who registers can sign in: set it, or turn the confirmation off
# with GEOPORTAL_CONFIRM_EMAIL=false. MAIL_START_TLS is DISABLED, OPTIONAL or REQUIRED; MAIL_TLS=true for
# a server that speaks TLS from the start (port 465).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_START_TLS=REQUIRED
MAIL_TLS=false
MAIL_FROM=Geoportal <no-reply@localhost>
GEOPORTAL_CONFIRM_EMAIL=true
# The address of Geoportal as people reach it, for the links in mails (such as https://geo.example.org);
# empty: the address of the request.
GEOPORTAL_PUBLIC_URL=
# For demonstrations and reviews, a mail catcher that keeps every mail and sends none, readable at
# http://127.0.0.1:MAIL_CATCHER_PORT: uncomment these lines (they replace the ones above).
# COMPOSE_PROFILES=mail
# MAIL_HOST=mailcatcher
# MAIL_PORT=1025
# MAIL_START_TLS=DISABLED
MAIL_CATCHER_PORT=8025
