    <groupId>dev.geoportal</groupId>
    <artifactId>geoportal-proofstub</artifactId>
    <version>0.1.0</version>
    <name>Geoportal proof stub (GP-327, F01)</name>
    <description>PROOF STUB of the F01 proofs: the gateway go-ahead, personal keys, the AuthKey mapper and the REST role endpoints. Not part of the product.</description>
    <properties>
        <extension.package.name>proofstub</extension.package.name>
